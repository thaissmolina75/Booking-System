# Copy to .env.local and fill in. Only VITE_* values reach the browser.
# Local values come from: npx supabase status
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service role / secret key in this file or anywhere in src/.
# It bypasses row level security and belongs only on a server (the chatbot backend).
